+    if not isinstance(data, dict):
+        raise IsolisError("%s must contain a JSON object" % CONFIG_FILE)
+
+    profiles = {}
+    raw_profiles = data.get("profiles") or {}
+    if not isinstance(raw_profiles, dict):
+        raise IsolisError("config 'profiles' must be an object")
+    for name, override in raw_profiles.items():
+        if not isinstance(name, str) or not isinstance(override, dict):
+            raise IsolisError("config profiles entries must be objects")
+        unknown = set(override) - CONFIG_KEYS
+        if unknown:
